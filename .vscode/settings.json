{
   "files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      "**/.idea/": true
   },
   "explorerExclude.backup": {},
   "json.schemas": [
      {
         "fileMatch": [
            "/app/config/clients.json"
         ],
         "url": "./app/config/clients.schema.json"
      }
   ]
}
