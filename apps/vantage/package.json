{
  "name": "@artform/vantage",
  "version": "0.1.0",
  "private": true,
  "description": "Vantage — GovCon market opportunity intelligence SaaS.",
  "scripts": {
    "dev": "next dev --port 3200",
    "prebuild": "pnpm --filter @tabler/core run css",
    "build": "next build",
    "start": "next start --port 3200",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "shx rm -rf .next",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:validate": "prisma validate",
    "db:format": "prisma format"
  },
  "dependencies": {
    "@artform/suite-ui": "workspace:*",
    "@clerk/nextjs": "^6.39.6",
    "@prisma/client": "6.19.3",
    "@tabler/core": "workspace:*",
    "@tabler/icons-react": "^3.44.0",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "prisma": "6.19.3",
    "shx": "^0.4.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  }
}
