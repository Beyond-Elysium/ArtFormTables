# Vantage — environment
#
# See lib/sync/README.md for the full rundown of both government-data clients.

# --- Clerk (auth) ----------------------------------------------------------
# Get these from a Clerk dashboard project (https://dashboard.clerk.com).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3200

# --- Database ------------------------------------------------------------
# Postgres connection string (Supabase or Neon). Include `?sslmode=require`
# for most hosted providers. Example (Supabase pooled connection):
#   postgresql://postgres:<password>@<host>:6543/postgres?pgbouncer=true&sslmode=require
# Example (Neon):
#   postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=

# --- SAM.gov Opportunities API --------------------------------------------
# Free key from https://sam.gov/data-services. Rate-limited to 1,000
# requests/day on the free tier — see lib/sync/README.md for how that
# constrains NAICS-code coverage vs. poll frequency.
SAM_GOV_API_KEY=

# --- USASpending.gov -------------------------------------------------------
# No API key needed — it's a public, unauthenticated endpoint
# (https://api.usaspending.gov/api/v2/search/spending_by_award/).

# --- Cron auth ---------------------------------------------------------------
# Shared secret for GET /api/cron/sync — same CRON_SECRET convention as the
# report cron in app/app/api/cron/reports/route.ts (bearer token, or Vercel's
# x-vercel-cron header when running on Vercel Cron).
CRON_SECRET=

# --- HubSpot (TODO: not yet scoped) -----------------------------------------
# HUBSPOT_ACCESS_TOKEN=

# --- Stripe ------------------------------------------------------------------
# Secret key (sk_live_… / sk_test_…) and the signing secret for the webhook
# endpoint, once billing is wired up (out of scope for this pass).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Price IDs for each tier's monthly recurring price, created in the Stripe
# dashboard (Products) to match the tiers in lib/pricing.ts. Reserved here so
# the variable names are documented ahead of the billing work landing.
# STRIPE_PRICE_ID_TIER1=
# STRIPE_PRICE_ID_TIER2=
# STRIPE_PRICE_ID_TIER3=
