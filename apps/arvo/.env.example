# Arvo — environment

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe ----------------------------------------------------------------
# Secret key (sk_live_… / sk_test_…) and the signing secret for the webhook
# endpoint registered in the Stripe dashboard (see lib/billing/README.md).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs for each tier's monthly recurring price, created in the Stripe
# dashboard (Products) to match the tiers in lib/billing/tiers.ts. Uncomment
# and fill in once the products exist.
# STRIPE_PRICE_ID_PRACTITIONER=
# STRIPE_PRICE_ID_TEAM=
# STRIPE_PRICE_ID_AGENCY=
