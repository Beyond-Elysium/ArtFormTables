# ArtForm Dashboards — environment
#
# Every connector falls back to deterministic MOCK data when its credentials are
# absent, so the app renders fully with none of these set. Add credentials per
# provider to switch that source to live data.

# --- Google auth for GA4 + Search Console -------------------------------------
# Pick ONE method. OAuth is preferred when present.
#
# Option A — OAuth Web client (user-consented). Mint a refresh token once (e.g.
# via the OAuth Playground using your own client id/secret) for an account with
# access to the properties, granting BOTH scopes:
#   https://www.googleapis.com/auth/analytics.readonly
#   https://www.googleapis.com/auth/webmasters.readonly
# Publish the consent screen to "In production" so the refresh token doesn't
# expire after 7 days.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
#
# Option B — Service account. Raw or base64-encoded JSON key. Enable the
# Analytics Data API + Search Console API, then add the service-account email as
# a Viewer/user on each property/site.
#   base64 -w0 service-account.json   (Linux)  /  base64 -i … (macOS)
GA_SERVICE_ACCOUNT_KEY=

# --- Google Ads ---------------------------------------------------------------
# Google Ads needs a developer token + OAuth2 (not just a service account).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_OAUTH_REFRESH_TOKEN=
# Optional manager (MCC) account id used as login-customer-id.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional Google Ads API version (defaults to v18).
GOOGLE_ADS_API_VERSION=

# --- Bing Webmaster Tools -----------------------------------------------------
# Simple API key from the Bing Webmaster Tools settings.
BING_WEBMASTER_API_KEY=

# --- Meta Ads (Facebook / Instagram) ------------------------------------------
# Long-lived access token with ads_read on the ad account.
META_ACCESS_TOKEN=
# Optional Graph API version (defaults to v21.0).
META_API_VERSION=

# --- LinkedIn Ads -------------------------------------------------------------
# OAuth2 access token with r_ads_reporting.
LINKEDIN_ACCESS_TOKEN=
# Optional versioned API month (YYYYMM, defaults to 202405).
LINKEDIN_API_VERSION=

# --- Mailchimp ----------------------------------------------------------------
# API key in the form "xxxxxxxx-usNN" (datacenter is the suffix).
MAILCHIMP_API_KEY=

# --- Shopify ------------------------------------------------------------------
# Admin API access token from a custom app on the store.
SHOPIFY_ACCESS_TOKEN=
# Optional Admin API version (defaults to 2024-10).
SHOPIFY_API_VERSION=

# --- Stripe -------------------------------------------------------------------
# Secret (or restricted read-only) key, e.g. sk_live_… / rk_live_…
STRIPE_SECRET_KEY=

# --- Plausible Analytics ------------------------------------------------------
# API key (bearer).
PLAUSIBLE_API_KEY=
# Optional base URL for self-hosted instances (defaults to https://plausible.io).
PLAUSIBLE_BASE_URL=

# --- YouTube ------------------------------------------------------------------
# Data API v3 key (public channel statistics).
YOUTUBE_API_KEY=

# --- TikTok Ads ---------------------------------------------------------------
# Marketing API access token; optional API version (defaults to v1.3).
TIKTOK_ACCESS_TOKEN=
TIKTOK_API_VERSION=

# --- HubSpot ------------------------------------------------------------------
# Private-app access token (bearer).
HUBSPOT_ACCESS_TOKEN=

# --- SendGrid -----------------------------------------------------------------
# API key (bearer).
SENDGRID_API_KEY=

# --- PostHog ------------------------------------------------------------------
# Personal API key (bearer); optional host (defaults to https://us.posthog.com).
POSTHOG_API_KEY=
POSTHOG_HOST=

# --- Matomo -------------------------------------------------------------------
# Self-hosted/cloud base URL + an API auth token.
MATOMO_BASE_URL=
MATOMO_TOKEN=

# --- Pinterest Ads ------------------------------------------------------------
# OAuth2 access token with ads:read.
PINTEREST_ACCESS_TOKEN=

# --- Snapchat Ads -------------------------------------------------------------
# OAuth2 access token.
SNAPCHAT_ACCESS_TOKEN=

# --- Twilio -------------------------------------------------------------------
# Account SID + Auth Token (HTTP Basic).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Zendesk ------------------------------------------------------------------
# API token (used with the agent email via HTTP Basic).
ZENDESK_API_TOKEN=

# --- GitHub -------------------------------------------------------------------
# Token with repo read access (traffic endpoints need push/admin).
GITHUB_TOKEN=

# --- Calendly -----------------------------------------------------------------
# OAuth2 / personal access token (bearer).
CALENDLY_ACCESS_TOKEN=

# --- Intercom -----------------------------------------------------------------
# Access token (bearer); optional API version (default 2.11).
INTERCOM_ACCESS_TOKEN=
INTERCOM_VERSION=

# --- Typeform -----------------------------------------------------------------
# Personal access token (bearer).
TYPEFORM_ACCESS_TOKEN=

# --- Square -------------------------------------------------------------------
# Access token (bearer); optional API version (default 2024-10-17).
SQUARE_ACCESS_TOKEN=
SQUARE_VERSION=

# --- PayPal -------------------------------------------------------------------
# OAuth2 client-credentials; base URL defaults to live (use the sandbox URL to test).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=

# --- Cloudflare ---------------------------------------------------------------
# API token with Analytics:Read on the zone.
CLOUDFLARE_API_TOKEN=

# --- Klaviyo ------------------------------------------------------------------
# Private API key; optional revision date (default 2024-10-15).
KLAVIYO_API_KEY=
KLAVIYO_REVISION=

# --- Sentry -------------------------------------------------------------------
# Auth token (bearer); optional base URL for self-hosted.
SENTRY_AUTH_TOKEN=
SENTRY_BASE_URL=

# --- Linear -------------------------------------------------------------------
# Personal API key (sent raw, no Bearer prefix).
LINEAR_API_KEY=

# --- Zoom ---------------------------------------------------------------------
# Server-to-Server OAuth app credentials.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Amplitude ----------------------------------------------------------------
# API key + secret key (HTTP Basic); optional base URL (EU residency).
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET_KEY=
AMPLITUDE_BASE_URL=

# --- ActiveCampaign -----------------------------------------------------------
# Account API URL + token.
ACTIVECAMPAIGN_API_URL=
ACTIVECAMPAIGN_API_TOKEN=

# --- Airtable -----------------------------------------------------------------
# Personal access token (bearer).
AIRTABLE_API_KEY=

# Clients are served at sitename.com/<slug> (path-based routing) — no root-domain
# or wildcard-subdomain configuration is required.

# --- PDF / email reporting (optional) -----------------------------------------
# See REPORTS.md. Reporting degrades gracefully: with no RESEND_API_KEY, PDF
# download still works but emails are skipped.
RESEND_API_KEY=
REPORT_FROM="ArtForm Reports <reports@artform.agency>"
# Path to a Chromium binary for the PDF renderer (playwright-core).
#   Local example: /opt/pw-browsers/chromium-1194/chrome-linux/chrome
#   Vercel: install @sparticuz/chromium and set this to its executablePath.
CHROMIUM_EXECUTABLE_PATH=
# Shared secret protecting POST /api/report/* and the report cron.
CRON_SECRET=
