# ArtForm Dashboards — environment

# Base64-encoded Google Cloud service-account JSON key.
# The service account must be added as a "Viewer" on each client's GA4 property,
# and the Google Analytics Data API must be enabled in the GCP project.
#
# Generate with:  base64 -w0 service-account.json   (Linux)
#                 base64 -i service-account.json     (macOS)
#
# If this is unset, the app serves deterministic MOCK data so dashboards still
# render during development.
GA_SERVICE_ACCOUNT_KEY=

# Apex domain used to derive client subdomains (e.g. "dashboards.artform.com").
# A request to acme.dashboards.artform.com resolves to the "acme" client.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
