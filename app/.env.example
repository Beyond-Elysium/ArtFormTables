# ArtForm Dashboards — environment
#
# Every connector falls back to deterministic MOCK data when its credentials are
# absent, so the app renders fully with none of these set. Add credentials per
# provider to switch that source to live data.

# --- Google service account (GA4 + Search Console) ----------------------------
# Base64-encoded Google Cloud service-account JSON key. Enable the relevant APIs
# (Google Analytics Data API, Search Console API) in the GCP project, then add
# the service-account email as a Viewer/user on each client's property/site.
#
#   base64 -w0 service-account.json   (Linux)
#   base64 -i service-account.json    (macOS)
GA_SERVICE_ACCOUNT_KEY=

# --- Google Ads ---------------------------------------------------------------
# Google Ads needs a developer token + OAuth2 (not just a service account).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_OAUTH_REFRESH_TOKEN=
# Optional manager (MCC) account id used as login-customer-id.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Bing Webmaster Tools -----------------------------------------------------
# Simple API key from the Bing Webmaster Tools settings.
BING_WEBMASTER_API_KEY=

# --- App ----------------------------------------------------------------------
# Apex domain used to derive client subdomains (e.g. "dashboards.artform.com").
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
