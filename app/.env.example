# ArtForm Dashboards — environment
#
# Every connector falls back to deterministic MOCK data when its credentials are
# absent, so the app renders fully with none of these set. Add credentials per
# provider to switch that source to live data.

# --- ArtForm Intelligence Suite ------------------------------------------------
# Public base URL for this dashboard app. Required outside local dev for
# server-side PDF/report routes so they never trust request Host headers.
APP_BASE_URL=
#
# Where the /artform dashboard's Suite card links to. Defaults to the local dev
# port (see apps/arvo/README.md); set to Arvo's real deployed URL in production.
ARVO_APP_URL=

# --- Google auth for GA4 + Search Console -------------------------------------
# Pick ONE method. OAuth is preferred when present.
# --- Google auth for GA4 + Search Console + Google Sheets ---------------------
# Pick ONE method. OAuth is preferred when present. The gsheets connector needs
# NO extra env — it reuses this credential; the consenting account (or service
# account) must have view access to each spreadsheet it reads.
#
# Option A — OAuth Web client (user-consented). Mint a refresh token once (e.g.
# via the OAuth Playground using your own client id/secret) for an account with
# access to the properties, granting ALL the scopes you need:
#   https://www.googleapis.com/auth/analytics.readonly
#   https://www.googleapis.com/auth/webmasters.readonly
#   https://www.googleapis.com/auth/spreadsheets.readonly   (gsheets connector)
# Publish the consent screen to "In production" so the refresh token doesn't
# expire after 7 days.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
#
# Option B — Service account. Raw or base64-encoded JSON key. Enable the
# Analytics Data API + Search Console API, then add the service-account email as
# a Viewer/user on each property/site.
#   base64 -w0 service-account.json   (Linux)  /  base64 -i … (macOS)
GA_SERVICE_ACCOUNT_KEY=

# --- Google Ads ---------------------------------------------------------------
# Needs a developer token (always). The OAuth client id/secret/refresh-token
# fall back to the shared GOOGLE_OAUTH_* vars above, so one Web OAuth client +
# one refresh token (scoped for Analytics AND AdWords) can power GA4, Search
# Console, and Ads. Only set the GOOGLE_ADS_* client vars to use a DIFFERENT
# client for Ads.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_OAUTH_REFRESH_TOKEN=
# Optional manager (MCC) account id used as login-customer-id.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional Google Ads API version (defaults to v24, the newest stable major as
# of 2026-07). Versions sunset ~a year after release — if live Ads suddenly
# degrades to demo data with a "version retired" error, set this to a
# currently-supported version:
# https://developers.google.com/google-ads/api/docs/sunset-dates
GOOGLE_ADS_API_VERSION=

# --- Bing Webmaster Tools -----------------------------------------------------
# Simple API key from the Bing Webmaster Tools settings.
BING_WEBMASTER_API_KEY=

# --- Meta Ads (Facebook / Instagram) ------------------------------------------
# Long-lived access token with ads_read on the ad account.
META_ACCESS_TOKEN=
# Optional Graph API version (defaults to v21.0).
META_API_VERSION=

# --- LinkedIn Ads -------------------------------------------------------------
# OAuth2 access token with r_ads_reporting.
LINKEDIN_ACCESS_TOKEN=
# Optional versioned API month (YYYYMM, defaults to 202405).
LINKEDIN_API_VERSION=

# --- Mailchimp ----------------------------------------------------------------
# API key in the form "xxxxxxxx-usNN" (datacenter is the suffix).
MAILCHIMP_API_KEY=

# --- Shopify ------------------------------------------------------------------
# Admin API access token from a custom app on the store.
SHOPIFY_ACCESS_TOKEN=
# Optional Admin API version (defaults to 2024-10).
SHOPIFY_API_VERSION=

# --- Stripe -------------------------------------------------------------------
# Secret (or restricted read-only) key, e.g. sk_live_… / rk_live_…
STRIPE_SECRET_KEY=

# --- Plausible Analytics ------------------------------------------------------
# API key (bearer).
PLAUSIBLE_API_KEY=
# Optional base URL for self-hosted instances (defaults to https://plausible.io).
PLAUSIBLE_BASE_URL=

# --- YouTube ------------------------------------------------------------------
# Data API v3 key (public channel statistics).
YOUTUBE_API_KEY=

# --- TikTok Ads ---------------------------------------------------------------
# Marketing API access token; optional API version (defaults to v1.3).
TIKTOK_ACCESS_TOKEN=
TIKTOK_API_VERSION=

# --- HubSpot ------------------------------------------------------------------
# Private-app access token (bearer). A token is scoped to ONE HubSpot portal, so
# multi-client setups need one token per client's account. A client's hubspot
# source names its own env var via config.tokenEnv; set the matching vars below.
# HUBSPOT_ACCESS_TOKEN is the shared fallback for a source without tokenEnv.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_TOKEN_ARTFORM=
HUBSPOT_TOKEN_BBBNP=
HUBSPOT_TOKEN_MAXIMUS=

# --- SendGrid -----------------------------------------------------------------
# API key (bearer).
SENDGRID_API_KEY=

# --- PostHog ------------------------------------------------------------------
# Personal API key (bearer); optional host (defaults to https://us.posthog.com).
POSTHOG_API_KEY=
POSTHOG_HOST=

# --- Matomo -------------------------------------------------------------------
# Self-hosted/cloud base URL + an API auth token.
MATOMO_BASE_URL=
MATOMO_TOKEN=

# --- Pinterest Ads ------------------------------------------------------------
# OAuth2 access token with ads:read.
PINTEREST_ACCESS_TOKEN=

# --- Snapchat Ads -------------------------------------------------------------
# OAuth2 access token.
SNAPCHAT_ACCESS_TOKEN=

# --- Twilio -------------------------------------------------------------------
# Account SID + Auth Token (HTTP Basic).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Zendesk ------------------------------------------------------------------
# API token (used with the agent email via HTTP Basic).
ZENDESK_API_TOKEN=

# --- GitHub -------------------------------------------------------------------
# Token with repo read access (traffic endpoints need push/admin).
GITHUB_TOKEN=

# --- Calendly -----------------------------------------------------------------
# OAuth2 / personal access token (bearer).
CALENDLY_ACCESS_TOKEN=

# --- Intercom -----------------------------------------------------------------
# Access token (bearer); optional API version (default 2.11).
INTERCOM_ACCESS_TOKEN=
INTERCOM_VERSION=

# --- Typeform -----------------------------------------------------------------
# Personal access token (bearer).
TYPEFORM_ACCESS_TOKEN=

# --- Square -------------------------------------------------------------------
# Access token (bearer); optional API version (default 2024-10-17).
SQUARE_ACCESS_TOKEN=
SQUARE_VERSION=

# --- PayPal -------------------------------------------------------------------
# OAuth2 client-credentials; base URL defaults to live (use the sandbox URL to test).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=

# --- Cloudflare ---------------------------------------------------------------
# API token with Analytics:Read on the zone.
CLOUDFLARE_API_TOKEN=

# --- Klaviyo ------------------------------------------------------------------
# Private API key; optional revision date (default 2024-10-15).
KLAVIYO_API_KEY=
KLAVIYO_REVISION=

# --- Sentry -------------------------------------------------------------------
# Auth token (bearer); optional base URL for self-hosted.
SENTRY_AUTH_TOKEN=
SENTRY_BASE_URL=

# --- Linear -------------------------------------------------------------------
# Personal API key (sent raw, no Bearer prefix).
LINEAR_API_KEY=

# --- Zoom ---------------------------------------------------------------------
# Server-to-Server OAuth app credentials.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Amplitude ----------------------------------------------------------------
# API key + secret key (HTTP Basic); optional base URL (EU residency).
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET_KEY=
AMPLITUDE_BASE_URL=

# --- ActiveCampaign -----------------------------------------------------------
# Account API URL + token.
ACTIVECAMPAIGN_API_URL=
ACTIVECAMPAIGN_API_TOKEN=

# --- Airtable -----------------------------------------------------------------
# Personal access token (bearer).
AIRTABLE_API_KEY=

# --- Microsoft Advertising (Bing Ads) ------------------------------------------
# OAuth2 refresh-token exchange (Microsoft identity platform) + a developer
# token from the Microsoft Advertising developer portal. Getting these usually
# requires an approved developer application against an account with ad-spend
# history — see microsoftAds.ts's header comment for the live-fetch shape.
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_REFRESH_TOKEN=
MICROSOFT_ADS_DEVELOPER_TOKEN=
# Optional manager/agency customer id, if the account sits under one.
MICROSOFT_ADS_CUSTOMER_ID=

# --- PageSpeed Insights -------------------------------------------------------
# Free: a Google Cloud API key with the "PageSpeed Insights API" enabled. No
# OAuth and no per-site verification — it measures any public URL. The endpoint
# works keyless but throttles hard, so the connector treats the key as required.
# Note: a Lighthouse run takes ~10-30s; results are served from the 1-hour
# connector cache, so that cost is once per client per window.
PAGESPEED_API_KEY=

# --- NocoDB ---------------------------------------------------------------
# Open-source, self-hosted Airtable-style database. Personal API token
# (xc-token header) + the instance's base URL; each source then only needs a
# tableId.
NOCODB_API_TOKEN=
NOCODB_BASE_URL=

# Clients are served at sitename.com/<slug> (path-based routing) — no root-domain
# or wildcard-subdomain configuration is required.

# --- Semantic layer (optional) ------------------------------------------------
# The boring-semantic-layer + DuckDB service (see /semantic). Server-to-server;
# leave unset to disable (the app degrades). Token must match the service's
# SEMANTIC_API_TOKEN. In production the URL MUST be https (the bearer token
# travels in this channel) — put Caddy in front of the service; see
# semantic/README.md "Hardening". Plain http://localhost is fine for local dev.
SEMANTIC_API_URL=
SEMANTIC_API_TOKEN=
# Anthropic API key for NLQ ("ask your dashboard") on the Explore page. Server-
# side only — never reaches the browser. NLQ also needs SEMANTIC_API_URL above;
# with either unset, the Ask box is hidden and everything else still works.
ANTHROPIC_API_KEY=

# --- PDF / email reporting (optional) -----------------------------------------
# See REPORTS.md. Reporting degrades gracefully: with no RESEND_API_KEY, PDF
# download still works but emails are skipped.
RESEND_API_KEY=
REPORT_FROM="ArtForm Reports <reports@artform.agency>"
# Path to a Chromium binary for the PDF renderer (playwright-core).
#   Local example: /opt/pw-browsers/chromium-1194/chrome-linux/chrome
#   Vercel: install @sparticuz/chromium and set this to its executablePath.
CHROMIUM_EXECUTABLE_PATH=
# Shared secret protecting POST /api/report/* and the report cron.
CRON_SECRET=
